# Unity standard gitignore
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.plastic/
ignore.conf
Library/
Temp/
Builds/

# Asset meta files for folders without user content
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / IDE cache
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS generated files
.DS_Store
Thumbs.db
[Dd]esktop.ini

# Crash reports
sysinfo.txt
*.stackdump
